{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/promptprobe/jstack/blob/main/schemas/config.schema.json",
  "title": "jstack project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1, "type": "integer" },
    "budget": { "enum": ["cheap", "normal", "deep"], "default": "normal" },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "max_children": { "type": "integer", "minimum": 0, "maximum": 3, "default": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 120 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$" } },
              "required": { "type": "boolean", "default": true },
              "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
            }
          }
        }
      }
    }
  }
}
